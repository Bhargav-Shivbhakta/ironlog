rules_version = '2';

// Security rules for student sign-in and class rosters. Paste this whole file into
// Firebase console → Firestore Database → Rules, then click Publish.
//
// 1. Put the site admin email(s) in admins() below (lowercase). Admins create classes
//    and upload rosters. Class instructors are set per class on the Admin page.
// 2. Change sdsu[.]edu if your school uses a different email ending.
service cloud.firestore {
  match /databases/{database}/documents {

    function admins() {
      return ['bshivbhakta@sdsu.edu'];
    }

    function schoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@sdsu[.]edu$');
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAdmin() { return schoolAccount() && myEmail() in admins(); }

    function enrollmentPath() { return /databases/$(database)/documents/enrollments/$(myEmail()); }
    function isEnrolledAnywhere() { return schoolAccount() && exists(enrollmentPath()) && get(enrollmentPath()).data.classes.size() > 0; }
    function enrolledIn(classId) { return schoolAccount() && exists(enrollmentPath()) && classId in get(enrollmentPath()).data.classes; }

    function classDoc(classId) { return get(/databases/$(database)/documents/classes/$(classId)).data; }
    function teaches(classId) { return schoolAccount() && myEmail() in classDoc(classId).instructors; }
    // the class's instructor (not a TA), as the admin set it on the class: read from their own enrollment
    function leads(classId) {
      return teaches(classId) && exists(enrollmentPath())
        && get(enrollmentPath()).data.classes.get(classId, {}).get('role', '') == 'instructor';
    }
    // An instructor adding, editing or removing ONE student of their own class. The write names the
    // class in editClass; only that class's entry may change, and only for students (never staff).
    function instructorRosterEdit(email) {
      let d = request.resource.data;
      let c = d.get('editClass', '');
      let before = resource == null ? {} : resource.data.get('classes', {});
      let after = d.get('classes', {});
      return c is string && c != '' && leads(c)
        && d.get('email', '') == email
        && d.keys().hasOnly(['email', 'classes', 'editClass'])
        && after.diff(before).affectedKeys().hasOnly([c])
        && (!(c in before) || before[c].get('role', 'student') == 'student')
        && (!(c in after) || after[c].get('role', '') == 'student');
    }

    // ---- timed exams: starting and saving an attempt
    function testOf(classId, testId) { return get(/databases/$(database)/documents/classes/$(classId)/tests/$(testId)).data; }
    // An exam for some sections only has windows: { "<section>": { opensAt, closesAt } }. The student's
    // section is the one on their enrollment; students in other sections can't open or start it.
    function mySection(classId) { return get(enrollmentPath()).data.classes[classId].get('section', ''); }
    function hasWindows(t) { return t.get('windows', null) != null; }
    function examOpened(classId, t) {
      return (!hasWindows(t) && request.time >= t.opensAt)
        || (hasWindows(t) && request.time >= t.windows[mySection(classId)].opensAt);
    }
    function beforeClose(classId, t, extraMin, graceSec) {
      return (!hasWindows(t) && request.time < t.closesAt + duration.value(extraMin, 'm') + duration.value(graceSec, 's'))
        || (hasWindows(t) && request.time < t.windows[mySection(classId)].closesAt + duration.value(extraMin, 'm') + duration.value(graceSec, 's'));
    }
    // A section can have its own time limit and its own access-code rule (set on the exam); a section's
    // own code is in testCodes/{T}.sections, otherwise the exam's code is used.
    function needCode(classId, t) {
      return (!hasWindows(t) && t.get('requireCode', false) == true)
        || (hasWindows(t) && t.windows[mySection(classId)].get('requireCode', t.get('requireCode', false)) == true);
    }
    function codeOk(classId, tid, d) {
      let codes = get(/databases/$(database)/documents/classes/$(classId)/testCodes/$(tid)).data;
      return d.get('code', '') == codes.get('sections', {}).get(mySection(classId), codes.get('code', ''));
    }
    function withinLimit(classId, t, old) {
      return (!hasWindows(t) && request.time <= old.startedAt + duration.value(int(t.durationMin) + int(old.extraMin), 'm') + duration.value(30, 's'))
        || (hasWindows(t) && request.time <= old.startedAt + duration.value(int(t.windows[mySection(classId)].get('durationMin', t.durationMin)) + int(old.extraMin), 'm') + duration.value(30, 's'));
    }
    function startOk(classId, attemptId, d) {
      let t = testOf(classId, d.tid);
      let ex = /databases/$(database)/documents/classes/$(classId)/testExtra/$(d.tid + '_' + myEmail());
      return attemptId == d.tid + '_' + request.auth.uid
        && d.keys().hasOnly(['tid', 'uid', 'email', 'name', 'status', 'session', 'startedAt', 'beatAt', 'answers', 'events', 'saves', 'extraMin', 'device', 'reopened', 'submittedAt', 'endedReason', 'code', 'stateKey'])
        && (!('stateKey' in d) || d.stateKey.matches(d.tid + '[|][0-9]{15}'))
        && d.uid == request.auth.uid
        && d.email == myEmail()
        && d.status == 'open'
        && d.session is string && d.session.size() >= 16
        && d.startedAt == request.time
        && d.beatAt == request.time
        && d.saves == 0
        && d.reopened == 0
        && t.status == 'published'
        && t.get('disabled', false) != true
        && examOpened(classId, t)
        && beforeClose(classId, t, 0, 0)
        && ((!exists(ex) && d.extraMin == 0) || (exists(ex) && d.extraMin == get(ex).data.minutes))
        && (!needCode(classId, t) || codeOk(classId, d.tid, d));
    }
    // Saves must come from the device that started (or, after the professor lets the student back in,
    // the device that takes over), at least every 5 minutes, and before the time is up (30 s grace).
    function saveOk(classId, old, d) {
      let t = testOf(classId, old.tid);
      return old.status == 'open'
        && d.diff(old).affectedKeys().hasOnly(['answers', 'events', 'status', 'endedReason', 'submittedAt', 'beatAt', 'saves', 'session', 'device', 'stateKey'])
        && (!('stateKey' in d) || d.stateKey.matches(old.tid + '[|][0-9]{15}'))
        && (d.session == old.session || (old.session == '' && d.session is string && d.session.size() >= 16))
        && d.beatAt == request.time
        && request.time <= old.beatAt + duration.value(300, 's')
        && withinLimit(classId, t, old)
        && beforeClose(classId, t, int(old.extraMin), 30)
        && d.status in ['open', 'submitted', 'ended']
        && (d.status == 'open' || d.submittedAt == request.time);
    }

    // ---- admin check (the site reads this to decide whether to show the Admin page)
    match /admins/{email} {
      allow read: if isAdmin();
    }

    // ---- classes, rosters and enrollments: admins change everything; a class's instructor can
    //      add, edit and remove the students of their own class (not staff, not other classes)
    match /classes/{classId} {
      allow read: if isAdmin() || teaches(classId) || enrolledIn(classId);
      allow write: if isAdmin();
      // a class's instructors can add or remove the exams they upload, turn practice on/off and set
      // due dates, and list their timed exams; its instructor also keeps the student count up to date
      // (TAs: practice only. Graded work, the 'timed' list, is set up by the class's instructor.)
      allow update: if teaches(classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exams', 'updatedAt', 'practice']);
      allow update: if leads(classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exams', 'updatedAt', 'timed', 'practice', 'study', 'tools']);
      allow update: if leads(classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount', 'updatedAt', 'updatedBy']);

      // Exams and assignments uploaded on the site: everyone in the class reads them,
      // the class's instructors (and admins) upload, replace and delete them.
      // Study pages: one per unit (the notes, and what to practise). Students can open a unit from
      // the day it starts; the list of units (titles and dates only) is on the class itself.
      match /study/{unitId} {
        allow get: if isAdmin() || teaches(classId) || (enrolledIn(classId) && request.time.toMillis() >= resource.data.opensAt);
        allow list: if isAdmin() || teaches(classId);
        allow write: if isAdmin() || leads(classId);
      }
      match /exams/{examId} {
        allow read: if isAdmin() || teaches(classId) || enrolledIn(classId);
        allow write: if isAdmin() || teaches(classId);
      }
      match /examFiles/{examId} {
        allow read: if isAdmin() || teaches(classId) || enrolledIn(classId);
        allow write: if isAdmin() || teaches(classId);
      }
      match /assignmentSets/{examId} {
        allow read: if isAdmin() || teaches(classId) || enrolledIn(classId);
        allow write: if isAdmin() || teaches(classId);
      }
      // the original assignment files, including reference solutions: instructors only
      match /assignmentFiles/{examId} {
        allow read, write: if isAdmin() || teaches(classId);
      }

      // Announcements: the class's instructors post them, everyone in the class reads them.
      match /announcements/{annId} {
        allow read: if isAdmin() || teaches(classId) || enrolledIn(classId);
        allow create, update: if (isAdmin() || teaches(classId))
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && request.resource.data.authorEmail == myEmail();
        allow delete: if isAdmin() || teaches(classId);
      }

      // Question reports from students: they create/replace their own, instructors read and resolve.
      match /reports/{reportId} {
        allow read: if isAdmin() || teaches(classId);
        allow create, update: if enrolledIn(classId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == myEmail()
          && request.resource.data.classId == classId
          && request.resource.data.examId in classDoc(classId).exams
          && reportId.matches(request.auth.uid + '_.*')
          && request.resource.data.note.size() <= 600
          && request.resource.data.status == 'open';
        allow update: if (isAdmin() || teaches(classId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
        allow delete: if isAdmin();
      }

      // "This student has signed in": one small record per student per class, refreshed at most
      // once a day, so the dashboard knows who signed in even before they practise an exam.
      match /signins/{studentUid} {
        allow read: if isAdmin() || teaches(classId);
        allow create, update: if enrolledIn(classId) && studentUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'email', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == myEmail()
          && request.resource.data.at is number;
        allow write: if isAdmin();
      }

      // ---------------- Timed exams ----------------
      // The exam itself: questions and choices only (no answers). Students can open it only once it
      // is published and its start time (for their section) has passed, by Firebase's clock.
      // Graded work: the class's instructor creates, changes, releases and deletes it; TAs can see it,
      // proctor (Live tab: let back in, add time, end, new access code) and grade.
      match /tests/{testId} {
        allow read: if isAdmin() || teaches(classId)
          || (enrolledIn(classId) && resource.data.status == 'published' && examOpened(classId, resource.data));
        allow write: if isAdmin() || leads(classId);
      }
      // Answer keys and hidden tests: the class's staff only, never students.
      match /testKeys/{testId} {
        allow read: if isAdmin() || teaches(classId);
        allow write: if isAdmin() || leads(classId);
      }
      // The access code students type to start (shown by the professor in the room). Staff only:
      // students never read it; the start rule above compares what they typed with it.
      match /testCodes/{testId} {
        allow read, write: if isAdmin() || teaches(classId);
      }
      // Extra time for one student (accommodations). Id: "<testId>_<email>". A student can look up their
      // own (or find that there is none); the start rule checks the minutes they claim.
      match /testExtra/{extraId} {
        allow get: if enrolledIn(classId) && (resource == null || resource.data.email == myEmail());
        allow read: if isAdmin() || teaches(classId);
        allow write: if isAdmin() || leads(classId);
      }
      // One attempt per student per exam. Id: "<testId>_<uid>" (checked by id, so a student can also
      // look for an attempt that doesn't exist yet).
      match /attempts/{attemptId} {
        allow read: if isAdmin() || teaches(classId) || (enrolledIn(classId) && attemptId.matches('.+_' + request.auth.uid));
        // starting: only while the exam is open, only once (the id is fixed), times set by Firebase
        allow create: if enrolledIn(classId) && startOk(classId, attemptId, request.resource.data);
        // saving and submitting: only from the same device, only while the attempt is open and in time
        allow update: if enrolledIn(classId) && resource.data.uid == request.auth.uid && saveOk(classId, resource.data, request.resource.data);
        // the professor: let a student back in, add time, end an attempt
        allow update: if isAdmin() || teaches(classId);
        allow delete: if isAdmin() || leads(classId);
      }
      // Build my course: the setup and the text read from the professor's own files. The class's
      // instructor writes; TAs can look; students never see any of it.
      // (builder also holds the connector link code, so only the instructor reads it)
      match /builder/{docId} {
        allow read, write: if isAdmin() || leads(classId);
      }
      // What the build made (notes, question sets, assignments with solutions): staff only
      match /built/{stepId} {
        allow read: if isAdmin() || teaches(classId);
        allow write: if isAdmin() || leads(classId);
      }
      match /materials/{materialId} {
        allow read: if isAdmin() || teaches(classId);
        allow write: if isAdmin() || leads(classId);
      }
      match /materialText/{chunkId} {
        allow read: if isAdmin() || teaches(classId);
        allow write: if isAdmin() || leads(classId);
      }
      // A submitted attempt kept when the professor gives a student a new attempt (staff only)
      match /attemptArchive/{archiveId} {
        allow read: if isAdmin() || teaches(classId);
        allow write: if isAdmin() || leads(classId);
      }
      // Scores: students see their own only after the professor releases them.
      match /testGrades/{gradeId} {
        allow read: if isAdmin() || teaches(classId)
          || (enrolledIn(classId) && resource != null && resource.data.uid == request.auth.uid
              && testOf(classId, resource.data.tid).released == true);
        allow write: if isAdmin() || teaches(classId);
      }

      // Real exam scores uploaded for the Analytics page: the class's staff only, never students.
      match /grades/{gradeId} {
        allow read, write: if isAdmin() || teaches(classId);
      }

      // A student's summary and code for one exam, readable by that class's instructors.
      // Document id is "<uid>_<examId>"; students can only write their own, for exams of this class.
      match /{kind}/{docId} {
        allow read: if isAdmin() || teaches(classId);
        allow create, update: if kind in ['summaries', 'code']
          && enrolledIn(classId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == myEmail()
          && request.resource.data.classId == classId
          && request.resource.data.examId in classDoc(classId).exams
          && docId == request.auth.uid + '_' + request.resource.data.examId;
        allow delete: if isAdmin();
      }
    }
    // A student's private link for the tutor connector → which class's notes it may read.
    // A student can make one only for themselves, in a class they are in. Nobody can list them.
    match /tutorLinks/{code} {
      allow get, delete: if isAdmin() || resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && code.matches('^[A-Za-z0-9]{32}$')
        && (enrolledIn(request.resource.data.classId) || teaches(request.resource.data.classId));
    }
    // "Request access" on the landing page: anyone may send one request; only admins read them
    match /accessRequests/{id} {
      allow create: if id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['name', 'email', 'school', 'course', 'size', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && request.resource.data.email.size() <= 200
        && request.resource.data.school is string && request.resource.data.school.size() > 0 && request.resource.data.school.size() <= 150
        && request.resource.data.course is string && request.resource.data.course.size() > 0 && request.resource.data.course.size() <= 100
        && request.resource.data.size in ['Under 50', '50 to 150', '150 to 400', 'More than 400']
        && request.resource.data.createdAt is int && math.abs(request.resource.data.createdAt - request.time.toMillis()) < 600000;
      allow read, delete: if isAdmin();
    }
    // Build my course: the secret link code a professor gives their AI → which class it builds.
    // Nobody can list these; the connector service reads them with its own service account.
    match /buildLinks/{code} {
      allow get, delete: if isAdmin() || leads(resource.data.classId);
      allow create: if (isAdmin() || leads(request.resource.data.classId)) && code.matches('^[A-Za-z0-9]{32}$');
    }
    match /rosters/{classId} {
      allow read: if isAdmin() || teaches(classId);
      allow write: if isAdmin();
      // the list shown on the dashboard; who can open the class is decided by enrollments (below)
      allow update: if leads(classId)
        && request.resource.data.keys().hasOnly(['classId', 'people', 'updatedAt'])
        && request.resource.data.classId == classId;
    }
    match /enrollments/{email} {
      allow read: if isAdmin() || (schoolAccount() && email == myEmail());
      allow write: if isAdmin();
      allow create, update: if instructorRosterEdit(email);
    }

    // ---- school accounts that signed in but aren't on any roster (so the admin can spot
    //      email mismatches). Each person can only write their own email, name and time.
    match /signins/{email} {
      allow read: if isAdmin();
      allow create, update: if schoolAccount() && email == myEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
        && request.resource.data.email == myEmail()
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.at is number;
      allow delete: if isAdmin();
    }

    // ---- each person's own progress (synced between their devices)
    match /users/{uid} {
      allow read: if isAdmin() || (schoolAccount() && request.auth.uid == uid);
      allow create, update: if schoolAccount() && request.auth.uid == uid
        && (isEnrolledAnywhere() || isAdmin())
        && request.resource.data.uid == uid
        && request.resource.data.email == myEmail();
      allow delete: if false;

      match /{kind}/{examId} {
        allow read: if isAdmin() || (schoolAccount() && request.auth.uid == uid);
        allow create, update: if schoolAccount() && request.auth.uid == uid
          && (isEnrolledAnywhere() || isAdmin())
          && kind in ['exams', 'code']
          && request.resource.data.uid == uid
          && request.resource.data.email == myEmail()
          && request.resource.data.examId == examId;
        allow delete: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
